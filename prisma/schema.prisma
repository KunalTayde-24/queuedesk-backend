generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TokenStatus {
  WAITING
  CALLED
  DONE
}

model Token {
  id          String      @id @default(uuid())
  date        DateTime    @db.Date
  tokenNumber Int
  name        String
  mobile      String
  status      TokenStatus @default(WAITING)
  createdAt   DateTime    @default(now())

  // Concurrency backstop for daily numbering: two requests racing to compute
  // the same "next" number will have one insert fail on this constraint,
  // which the service layer catches and retries against.
  @@unique([date, tokenNumber])
  @@index([date, status])
  @@map("tokens")
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("admins")
}
