generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TokenStatus {
  WAITING
  CALLED
  DONE
}

model Token {
  id          String      @id @default(uuid())
  date        DateTime    @db.Date
  tokenNumber Int
  name        String
  mobile      String
  status      TokenStatus @default(WAITING)
  // When staff last called this token; "now serving" is the most recently called one.
  calledAt    DateTime?
  // The event whose queue this token is in. Null only for tokens taken before queues belonged
  // to events; every new token has one.
  eventId     String?
  event       Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())

  // Concurrency backstop for numbering: each event numbers its own queue per date. Two requests
  // racing to compute the same "next" number will have one insert fail on this constraint,
  // which the service layer catches and retries against.
  @@unique([eventId, date, tokenNumber])
  @@index([eventId, date, status])
  @@index([date, status])
  @@map("tokens")
}

// Dates the admin has opened for visitors to take tokens. A date with no row
// here is closed: visitors cannot pick it.
/// One row = one event's queue is open for visitors on one date.
model QueueDay {
  id        String   @id @default(uuid())
  date      DateTime @db.Date
  // Null only for days opened before queues belonged to events (history).
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([date, eventId])
  @@map("queue_days")
}

// One row per "send me a code" request. A row is verified once, then consumed
// by exactly one token, so a verified phone number cannot be reused.
model OtpChallenge {
  id         String    @id @default(uuid())
  mobile     String
  codeHash   String?
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([mobile, createdAt])
  @@map("otp_challenges")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum RegistrationStatus {
  REGISTERED
  CANCELLED
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  events       Event[]

  @@map("admins")
}

model Event {
  id                   String              @id @default(uuid())
  title                String
  description          String
  venue                String
  imageData            Bytes?
  imageMime            String?
  imageName            String?
  registrationOpensAt  DateTime
  registrationClosesAt DateTime
  startsAt             DateTime
  endsAt               DateTime
  needsQueue           Boolean             @default(true)
  status               EventStatus         @default(DRAFT)
  createdByAdminId     String?
  createdBy            Admin?              @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  registrations        EventRegistration[]
  tokens               Token[]
  queueDays            QueueDay[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([status, startsAt])
  @@index([status, registrationClosesAt])
  @@index([createdByAdminId])
  @@map("events")
}

model EventRegistration {
  id              String             @id @default(uuid())
  eventId         String
  event           Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name            String
  mobile          String
  email           String
  status          RegistrationStatus @default(REGISTERED)
  confirmationRef String             @unique
  registeredAt    DateTime           @default(now())
  cancelledAt     DateTime?

  @@unique([eventId, mobile])
  @@index([eventId, status])
  @@index([email])
  @@map("event_registrations")
}
