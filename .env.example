# Neon Postgres connection (pooled, used by the running app) — the
# "Pooled connection" string from the Neon dashboard
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/dbname?sslmode=require"
# Direct (non-pooled) connection, used only for running Prisma migrations —
# the "Direct connection" string from the Neon dashboard
DIRECT_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"

# Twilio WhatsApp
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_WHATSAPP_NUMBER="+14155238886"
TWILIO_TEMPLATE_SID="HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Freeform message text (used when no template SID is set). Placeholders:
# {name} = customer name, {token} = token number.
WHATSAPP_MESSAGE="Hi {name}, your token number {token} has been called. Please proceed to the counter."
# Country code added to older stored mobile numbers that have no country code,
# to form an E.164 number when sending WhatsApp messages (e.g. "+65" for Singapore).
# New numbers are stored with their own country code.
DEFAULT_COUNTRY_CODE="+65"

# Phone verification (OTP) when a visitor asks for a token.
#   dev           = test mode: nothing is sent, the code is printed in the server
#                   log and shown on screen. Never works on a hosted server.
#   twilio-verify = real codes through Twilio Verify (needs a paid Twilio account
#                   and a Verify service; SMS to India also needs DLT registration).
OTP_PROVIDER="dev"
# Set to "false" to forbid test mode on a hosted server (visitors then get "not set up yet")
OTP_ALLOW_TEST_MODE="true"
#   twilio-whatsapp = our own code sent as a WhatsApp message through Twilio. Works with
#                   the Twilio sandbox for testing; a real sender needs OTP_TEMPLATE_SID.
# Where Twilio Verify sends the code: sms | whatsapp
OTP_CHANNEL="sms"
# Verify Service SID from Twilio Console > Verify > Services (starts with VA)
TWILIO_VERIFY_SERVICE_SID="VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# twilio-whatsapp only: sender for the OTP (defaults to TWILIO_WHATSAPP_NUMBER) and, for a
# real WhatsApp sender, an approved template (HX...) whose body has one variable, {{1}}.
OTP_WHATSAPP_FROM="+14155238886"
OTP_TEMPLATE_SID=""
# How long a code stays valid, in seconds
OTP_TTL_SECONDS=300

# CORS: origin of the Next.js frontend
FRONTEND_URL="http://localhost:3000"

# Server port
PORT=3001

# Seed script only (read by `npm run seed`, NOT by the running server)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-please"

# 8x8 Connect SMS (connect.8x8.com) — set NOTIFY_PROVIDER=8x8-sms to send the
# "token called" message as an SMS, and OTP_PROVIDER=8x8-sms to send the OTP by SMS.
NOTIFY_PROVIDER=
EIGHTX8_API_KEY=
EIGHTX8_SUBACCOUNT_ID=
# Sender shown on the SMS. Singapore alphanumeric IDs may need SSIR registration;
# leave empty to use the account default.
EIGHTX8_SENDER_ID=
# Optional: override the API host (default https://sms.8x8.com)
EIGHTX8_BASE_URL=
# Optional freeform text for the token-called SMS. Placeholders: {name} {token}
SMS_MESSAGE=

# 8x8 Connect WhatsApp (Chat Apps) — NOTIFY_PROVIDER=8x8-whatsapp and/or OTP_PROVIDER=8x8-whatsapp.
# Uses the Chat Apps sub-account (e.g. *_CA_WA_*), NOT the SMS one, and approved templates.
EIGHTX8_WA_SUBACCOUNT_ID=
# Approved template for "token called"; body has one variable {{1}} = token number
EIGHTX8_WA_TOKEN_TEMPLATE=
# Approved template for the OTP; body has one variable {{1}} = the code
EIGHTX8_WA_OTP_TEMPLATE=
# true if the OTP template is an Authentication template with a "copy code" button
EIGHTX8_WA_OTP_BUTTON=
# Template language codes exactly as approved (e.g. en_SG, zh_CN). The generic one is a fallback.
EIGHTX8_WA_LANGUAGE=
EIGHTX8_WA_TOKEN_LANGUAGE=
EIGHTX8_WA_OTP_LANGUAGE=
