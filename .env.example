# Neon Postgres connection (pooled, used by the running app) — the
# "Pooled connection" string from the Neon dashboard
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/dbname?sslmode=require"
# Direct (non-pooled) connection, used only for running Prisma migrations —
# the "Direct connection" string from the Neon dashboard
DIRECT_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"

# Twilio WhatsApp
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_WHATSAPP_NUMBER="+14155238886"
TWILIO_TEMPLATE_SID="HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Freeform message text (used when no template SID is set). Placeholders:
# {name} = customer name, {token} = token number.
WHATSAPP_MESSAGE="Hi {name}, your token number {token} has been called. Please proceed to the counter."
# Country code prepended to the stored 10-digit mobile number to form an E.164
# number when sending WhatsApp messages (e.g. "+91" for India).
DEFAULT_COUNTRY_CODE="+91"

# CORS: origin of the Next.js frontend
FRONTEND_URL="http://localhost:3000"

# Server port
PORT=3001

# Seed script only (read by `npm run seed`, NOT by the running server)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-please"
